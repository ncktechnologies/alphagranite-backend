# Compose/runtime settings for DEV stack
COMPOSE_PROJECT_NAME=ag_dev
APP_ENV_FILE=.env.dev

# Host ports for DEV
WEB_HOST_PORT=8001
NGINX_HTTP_HOST_PORT=8081
NGINX_HTTPS_HOST_PORT=8444

# Public base URL used by API responses
BASE_URL=https://dev.api.ag.easybusiness.ng

# MCP AI planner settings (optional; deterministic routing remains default)
MCP_AI_ENABLE_LLM=false
MCP_AI_PRIMARY_PROVIDER=gemini
MCP_AI_SECONDARY_PROVIDER=gemini
MCP_AI_TIMEOUT_SECONDS=20

# Anthropic Claude (used when enabled and key is provided)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Optional Anthropic Agent routing (when set, planner/advisor first try Agent API then fallback to Messages API)
ANTHROPIC_AGENT_ID=
# Optional override endpoint (default: https://api.anthropic.com/v1/agents/{ANTHROPIC_AGENT_ID}/messages)
ANTHROPIC_AGENT_ENDPOINT=
# Optional Anthropic beta header if your agent requires one (example: agents-2024-xx-xx)
ANTHROPIC_BETA_HEADER=

# Google Gemini (used as fallback/secondary when enabled and key is provided)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional fallback model if primary response is invalid/truncated JSON
GEMINI_FALLBACK_MODEL=
