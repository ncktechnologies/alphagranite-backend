# Copy to .env.production and fill secrets locally; never source this as shell code.
COMPOSE_PROJECT_NAME=ag_production
APP_ENV_FILE=.env.production
WEB_HOST_PORT=8003
STATIC_HOST_DIR=/var/www/production/backend/alphagranite-backend/static
BASE_URL=https://api.odysseytracker.com
API_BASE_URL=https://api.odysseytracker.com

DATABASE_URL='postgresql://alpha_granite_prod_user:REPLACE_URL_ENCODED_PASSWORD@192.168.1.98:5432/alpha_granite_production'
APP_NAME=Alpha Granite Backend
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
TZ=America/Chicago
APP_TIMEZONE=America/Chicago

# Generate distinct production values with a password manager or openssl rand -hex 48.
SECRET_KEY=REPLACE_WITH_RANDOM_PRODUCTION_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOW_ORIGINS=https://ag.odysseytracker.com
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=support@odysseytracker.com
SUPERUSER_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
SUPERUSER_FIRST_NAME=Super
SUPERUSER_LAST_NAME=Admin

STATIC_DIR=/app/static
UPLOADS_DIR=/app/static/uploads
FILE_UPLOAD_ROOT=/app/static
UPLOAD_DIR=/app/static/jobs
MAX_UPLOAD_SIZE=5242880
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,glb

EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=support@odysseytracker.com
EMAIL_HOST_PASSWORD=REPLACE_WITH_MAILBOX_PASSWORD
DEFAULT_FROM_EMAIL=support@odysseytracker.com
ADMIN_EMAIL=tobi@carpediemts.com,notifications@carpediemts.com,sonia@alphagraniteaustin.com
SUPPORT_EMAIL=odyssey@alphagraniteaustin.com

# Enable monthly reports only after mail, data and recipients are verified.
EOM_STATUS_REPORT_ENABLED=false
HCP_PAYROLL_SCHEDULER_ENABLED=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
MCP_AI_ENABLE_LLM=false